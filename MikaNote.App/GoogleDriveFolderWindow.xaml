<Window x:Class="MikaNote.App.GoogleDriveFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Settings"
        Width="452"
        Height="548"
        MinWidth="452"
        MinHeight="548"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F1EA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="Background"
                    Value="#FAF7F0" />
            <Setter Property="Foreground"
                    Value="#2D3033" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FFFDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2EEE5" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18"
                      Height="18"
                      Margin="0,3,8,0"
                      VerticalAlignment="Top">
                    <Border Background="#5D88E8"
                            BorderBrush="#4A70C9"
                            BorderThickness="1"
                            CornerRadius="4" />
                    <Rectangle Width="8"
                               Height="5"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Fill="#EFF4FF"
                               RadiusX="1"
                               RadiusY="1" />
                    <Rectangle Width="10"
                               Height="6"
                               Margin="0,0,0,2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Fill="#F6C86B"
                               RadiusX="1.3"
                               RadiusY="1.3" />
                    <Rectangle Width="4"
                               Height="3"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Fill="#AFC4F6"
                               RadiusX="0.8"
                               RadiusY="0.8" />
                </Grid>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#2E2A24"
                           Text="Backup Settings" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0"
                       Foreground="#6B6255"
                       TextWrapping="Wrap"
                       Text="MikaNote can back up and restore your notes by using Google Drive for desktop on your PC." />
        </StackPanel>

        <Border x:Name="ConnectionStatusBorder"
                Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                Background="#FFFDF8"
                BorderBrush="#D8D0C3"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Foreground="#3F4347"
                           Text="Connection Status" />

                <Grid x:Name="DriveStatusRow"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Width="18"
                          Height="18"
                          Margin="0,1,8,0"
                          VerticalAlignment="Top">
                        <Ellipse x:Name="DriveFoundCircle"
                                 Fill="#F6DFDF"
                                 Stroke="#D65E5E"
                                 StrokeThickness="1.1" />
                        <Path x:Name="DriveFoundCheckIcon"
                              Width="9"
                              Height="7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="#2F9B5B"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M1.2,3.8 L3.7,6.2 L7.8,1.5"
                              Visibility="Collapsed" />
                        <Path x:Name="DriveFoundCrossIcon"
                              Width="8"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="#C84F4F"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M1.2,1.2 L6.8,6.8 M6.8,1.2 L1.2,6.8" />
                    </Grid>

                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="1"
                               Foreground="#6B6255"
                               Text="Google Drive for desktop not found." />
                </Grid>

                <Grid x:Name="BackupStatusRow"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Width="18"
                          Height="18"
                          Margin="0,1,8,0"
                          VerticalAlignment="Top">
                        <Ellipse x:Name="BackupFolderCircle"
                                 Fill="#F6DFDF"
                                 Stroke="#D65E5E"
                                 StrokeThickness="1.1" />
                        <Path x:Name="BackupFolderCheckIcon"
                              Width="9"
                              Height="7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="#2F9B5B"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M1.2,3.8 L3.7,6.2 L7.8,1.5"
                              Visibility="Collapsed" />
                        <Path x:Name="BackupFolderCrossIcon"
                              Width="8"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="#C84F4F"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M1.2,1.2 L6.8,6.8 M6.8,1.2 L1.2,6.8" />
                    </Grid>

                    <TextBlock x:Name="LinkedFolderTextBlock"
                               Grid.Column="1"
                               Foreground="#6B6255"
                               TextWrapping="Wrap"
                               Text="No backup folder selected." />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel x:Name="SetupPanel"
                    Grid.Row="2"
                    Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,6"
                       FontSize="11"
                       Foreground="#6B6255"
                       Text="Use this first to find Google Drive and set up the backup folder automatically." />
            <Button Style="{StaticResource DialogButtonStyle}"
                    Click="AutoConnectButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14"
                          Height="14"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Stroke="#5D88E8"
                                 StrokeThickness="1.4" />
                        <Path Stroke="#5D88E8"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M8.4,8.4 L12.2,12.2" />
                        <Path Stroke="#2F9B5B"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M7.2,11.2 L9.1,13 L12.7,9.1" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center"
                               Text="Find Google Drive &amp; Auto Setup" />
                </StackPanel>
            </Button>

            <Border Height="1"
                    Margin="0,18,0,15"
                    Background="#D8D0C3" />

            <TextBlock Margin="0,0,0,6"
                       FontSize="11"
                       Foreground="#6B6255"
                       Text="Use this if Google Drive for desktop is not installed yet." />
            <Button Style="{StaticResource DialogButtonStyle}"
                    Click="InstallGoogleDriveButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14"
                          Height="14"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center">
                        <Path Stroke="#5D88E8"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M7,1.5 V8.7 M7,8.7 L4.4,6.1 M7,8.7 L9.6,6.1" />
                        <Path Stroke="#F0B84F"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2.4,11.5 H11.6" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center"
                               Text="Install Google Drive" />
                </StackPanel>
            </Button>

            <TextBlock Margin="0,12,0,6"
                       FontSize="11"
                       Foreground="#6B6255"
                       Text="Use this only if MikaNote cannot find your synced Drive folder." />
            <Button
                    Style="{StaticResource DialogButtonStyle}"
                    Click="ChooseFolderButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14"
                          Height="14"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center">
                        <Path Fill="#F6C86B"
                              Stroke="#C59A42"
                              StrokeThickness="0.8"
                              Data="M1.5,4.4 H5.3 L6.4,5.6 H12.5 V11.6 H1.5 Z" />
                        <Path Fill="#FFE4A0"
                              Data="M1.5,5.8 H12.5 V11.6 H1.5 Z" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center"
                               Text="Choose Folder Manually" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel x:Name="BackupManagementPanel"
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
            <TextBlock FontWeight="SemiBold"
                       Foreground="#3F4347"
                       Text="Backup Folder" />
            <Border Margin="0,7,0,0"
                    Padding="10"
                    Background="#FFFDF8"
                    BorderBrush="#D8D0C3"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="BackupFolderPathTextBlock"
                           Foreground="#6B6255"
                           TextWrapping="Wrap"
                           Text="No backup folder linked." />
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="CreateBackupButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14"
                              Height="14"
                              Margin="0,0,7,0"
                              VerticalAlignment="Center">
                            <Path Stroke="#5D88E8"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M7,12 V4 M7,4 L4.3,6.7 M7,4 L9.7,6.7" />
                            <Path Stroke="#F0B84F"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M2.4,12 H11.6 M3,2.3 H11" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center"
                                   Text="Backup Now" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        MinWidth="92"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="Refresh"
                        Click="RefreshBackupsButton_Click" />
            </Grid>

            <TextBlock Margin="0,16,0,6"
                       FontWeight="SemiBold"
                       Foreground="#3F4347"
                       Text="Restore Backup" />
            <ComboBox x:Name="BackupFilesComboBox"
                      Height="34"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="FullPath" />
            <Button Margin="0,10,0,0"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="RestoreBackupButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14"
                          Height="14"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center">
                        <Path Stroke="#5D88E8"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M7,2.2 V10.2 M7,10.2 L4.3,7.5 M7,10.2 L9.7,7.5" />
                        <Path Stroke="#2F9B5B"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2.4,12 H11.6" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center"
                               Text="Restore Selected Backup" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="BackupActionStatusTextBlock"
                       Margin="0,12,0,0"
                       Foreground="#6B6255"
                       TextWrapping="Wrap"
                       Text="No backups loaded yet." />
        </StackPanel>

        <Grid Grid.Row="4"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="DisconnectButton"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    MinWidth="90"
                    Height="32"
                    Padding="12,0"
                    Style="{StaticResource DialogButtonStyle}"
                    Content="Disconnect"
                    Click="DisconnectButton_Click" />
            <Button x:Name="OpenFolderButton"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    MinWidth="94"
                    Height="32"
                    Padding="12,0"
                    Style="{StaticResource DialogButtonStyle}"
                    Content="Open Folder"
                    Click="OpenFolderButton_Click" />
            <Button Grid.Column="3"
                    MinWidth="64"
                    Height="32"
                    Padding="12,0"
                    Style="{StaticResource DialogButtonStyle}"
                    Content="Close"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>

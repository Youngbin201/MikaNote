<Window x:Class="MikaNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikaNote Manager"
        Width="1260"
        Height="760"
        MinWidth="1080"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="LeftPanelTabButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="84" />
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="#D8D0C3" />
            <Setter Property="Foreground"
                    Value="#6E6559" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12,12,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightPanelTabButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LeftPanelTabButtonStyle}" />

        <Style x:Key="PanelButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Padding"
                    Value="12,0" />
            <Setter Property="Background"
                    Value="#FAF7F0" />
            <Setter Property="Foreground"
                    Value="#2D3033" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FFFDF8" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#D8D0C3" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2EEE5" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerPanelButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Padding"
                    Value="12,0" />
            <Setter Property="Background"
                    Value="#B85A4E" />
            <Setter Property="Foreground"
                    Value="#FFFDF8" />
            <Setter Property="BorderBrush"
                    Value="#9E483D" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#C36659" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#A34D42" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#A84D41" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="Padding"
                    Value="10,0,28,0" />
            <Setter Property="Background"
                    Value="#FAF7F0" />
            <Setter Property="Foreground"
                    Value="#2D3033" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Path Width="8"
                                                  Height="5"
                                                  Margin="0,0,10,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Fill="#6E6559"
                                                  Data="M0,0 L8,0 L4,5 Z" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Chrome"
                                                        Property="Background"
                                                        Value="#FFFDF8" />
                                                <Setter TargetName="Chrome"
                                                        Property="BorderBrush"
                                                        Value="#D8D0C3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False" />

                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Background="#FFFDF8"
                                        BorderBrush="#D8D0C3"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer Padding="2"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerSliderStyle"
               TargetType="Slider">
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="8"
                                    VerticalAlignment="Center"
                                    Background="#F2EEE5"
                                    CornerRadius="4" />
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Height="8"
                                                  Background="#D8D0C3"
                                                  BorderThickness="0"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Height="8"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18"
                                           Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFFDF8"
                                                        BorderBrush="#D8D0C3"
                                                        BorderThickness="2"
                                                        CornerRadius="9" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="Foreground"
                    Value="#2D3033" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemRoot"
                                        Property="Background"
                                        Value="#F4F1EA" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemRoot"
                                        Property="Background"
                                        Value="#F2EEE5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedColorChipButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="Margin"
                    Value="0,0,7,7" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InactiveDarknessPresetButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="18" />
            <Setter Property="Height"
                    Value="18" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortModeButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="26" />
            <Setter Property="MinWidth"
                    Value="66" />
            <Setter Property="Margin"
                    Value="0,0,4,0" />
            <Setter Property="Padding"
                    Value="7,0,8,0" />
            <Setter Property="Background"
                    Value="#F4F1EA" />
            <Setter Property="Foreground"
                    Value="#5F574A" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FAF7F0" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FFFDF8" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SortModeButtonStyle}">
            <Setter Property="MinWidth"
                    Value="58" />
            <Setter Property="Padding"
                    Value="7,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FAF7F0" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FFFDF8" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteIconButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="#FAF7F0" />
            <Setter Property="Foreground"
                    Value="#B08A38" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#FFFDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2EEE5" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedReadOnlyScrollViewerStyle"
               TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="VerticalScrollBarVisibility"
                            Value="Auto" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScrollBarThumbStyle"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarVerticalScrollBarStyle"
               TargetType="ScrollBar">
            <Setter Property="Width"
                    Value="11" />
            <Setter Property="Background"
                    Value="#F4F1EA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Margin="0,2,0,2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#D8D0C3"
                                           Margin="1"
                                           Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContentVerticalScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource SidebarVerticalScrollBarStyle}">
            <Setter Property="Width"
                    Value="4" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Margin="0,3,0,3"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#F2EEE5"
                                           Margin="0"
                                           Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerInlineEditorTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding"
                    Value="9,7" />
            <Setter Property="Background"
                    Value="#FAF7F0" />
            <Setter Property="Foreground"
                    Value="#2E2A24" />
            <Setter Property="BorderBrush"
                    Value="#D8D0C3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="AcceptsReturn"
                    Value="True" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <Grid x:Name="TileRoot"
                  Width="150"
                  Height="150">
                <Button x:Name="TileButtonRoot"
                        Width="150"
                        Height="150"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Tag="{Binding}"
                        Click="TileButton_Click">
                    <Border Background="{Binding BackgroundBrush}"
                            CornerRadius="{Binding CornerRadius}"
                            Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#D8D0C3" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BorderBrush" Value="#2E2A24" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TileTitleText"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding TitleFontSize}"
                                       LineHeight="{Binding TitleLineHeight}"
                                       Foreground="{Binding TitleBrush}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock x:Name="TilePreviewText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       VerticalAlignment="Top"
                                       Text="{Binding PreviewText}"
                                       FontSize="{Binding ContentFontSize}"
                                       Foreground="{Binding ContentBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="{Binding ContentLineHeight}" />

                            <TextBlock x:Name="TileCreatedText"
                                       Grid.Row="2"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="{Binding ContentBrush}"
                                       Opacity="0.82"
                                       Text="{Binding RelativeTimeText}" />

                            <StackPanel x:Name="ActionContent"
                                        Grid.RowSpan="3"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{Binding ActionGlyphFontFamily}"
                                           FontSize="{Binding ActionGlyphFontSize}"
                                           FontWeight="Light"
                                           Foreground="{Binding ContentBrush}"
                                           Text="{Binding ActionGlyph}" />
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ContentBrush}"
                                           Text="{Binding ActionLabel}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>

                <Button x:Name="TileFavoriteButton"
                        Width="24"
                        Height="24"
                        Panel.ZIndex="2"
                        Margin="0,6,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Tag="{Binding}"
                        ToolTip="Favorite note"
                        Visibility="Collapsed"
                        Click="TileFavoriteButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#FFFDF8" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#EFE4CE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Path x:Name="TileFavoriteOutlineStar"
                              Width="12"
                              Height="12"
                              Stretch="Fill"
                              Stroke="#B08A38"
                              StrokeThickness="1.35"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M8,0.9 L10,5.2 L14.8,5.7 L11.2,8.9 L12.2,13.6 L8,11.2 L3.8,13.6 L4.8,8.9 L1.2,5.7 L6,5.2 Z" />
                        <Path x:Name="TileFavoriteFilledStar"
                              Width="12"
                              Height="12"
                              Stretch="Fill"
                              Fill="#E1B751"
                              Stroke="#B08A38"
                              StrokeThickness="1"
                              StrokeLineJoin="Round"
                              Data="M8,0.9 L10,5.2 L14.8,5.7 L11.2,8.9 L12.2,13.6 L8,11.2 L3.8,13.6 L4.8,8.9 L1.2,5.7 L6,5.2 Z"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="TileDeleteButton"
                        Width="24"
                        Height="24"
                        Panel.ZIndex="2"
                        Margin="0,0,6,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Padding="0"
                        Background="#F7F3EA"
                        BorderBrush="#E0D5C4"
                        BorderThickness="1"
                        Focusable="False"
                        Tag="{Binding}"
                        ToolTip="Move to trash"
                        Visibility="Collapsed"
                        Click="TileDeleteButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#FFFDF8" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#EFE4CE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="12"
                          Height="12">
                        <Path x:Name="TileDeleteIcon"
                              Stroke="#7A6F62"
                              StrokeThickness="1.25"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M2,3.2 H10 M4.1,3.2 V2.1 H7.9 V3.2 M3.4,4.3 V9.6 M6,4.3 V9.6 M8.6,4.3 V9.6 M3.1,3.2 L3.7,10.3 H8.3 L8.9,3.2" />
                        <Path x:Name="TileRestoreIcon"
                              Stroke="#7A6F62"
                              StrokeThickness="1.25"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed"
                              Data="M3,6.2 C3,4.2 4.6,2.6 6.6,2.6 H9.2 M6.2,1.3 L9,2.7 L6.2,4.1 M9,4.7 V9.2 H3.5 V5.7" />
                    </Grid>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAction}"
                             Value="True">
                    <Setter TargetName="ActionContent"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="TileTitleText"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="TilePreviewText"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="TileCreatedText"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="TileDeleteButton"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}"
                             Value="True">
                    <Setter TargetName="TileFavoriteButton"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="Background"
                            Value="Transparent" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="BorderBrush"
                            Value="Transparent" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="BorderThickness"
                            Value="0" />
                    <Setter TargetName="TileFavoriteFilledStar"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="TileFavoriteOutlineStar"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAction}"
                                   Value="False" />
                        <Condition Binding="{Binding IsFavorite}"
                                   Value="False" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=TileRoot}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TileFavoriteButton"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="Background"
                            Value="#F7F3EA" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="BorderBrush"
                            Value="#E0D5C4" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="BorderThickness"
                            Value="1" />
                    <Setter TargetName="TileDeleteButton"
                            Property="Visibility"
                            Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAction}"
                                   Value="False" />
                        <Condition Binding="{Binding IsFavorite}"
                                   Value="True" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=TileRoot}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TileFavoriteButton"
                            Property="Background"
                            Value="#F7F3EA" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="BorderBrush"
                            Value="#E0D5C4" />
                    <Setter TargetName="TileFavoriteButton"
                            Property="BorderThickness"
                            Value="1" />
                    <Setter TargetName="TileDeleteButton"
                            Property="Visibility"
                            Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsBackup}"
                             Value="True">
                    <Setter TargetName="TileDeleteButton"
                            Property="ToolTip"
                            Value="Restore note" />
                    <Setter TargetName="TileDeleteIcon"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="TileRestoreIcon"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">

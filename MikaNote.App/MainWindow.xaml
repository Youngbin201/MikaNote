                        <TextBlock x:Name="MemoSectionHeader"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#2E2A24"
                                   Text="Memo" />
                        <ItemsControl x:Name="MemoTilesItemsControl"
                                      Margin="0,10,0,18"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,14,14" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <TextBlock x:Name="TrashSectionHeader"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#2E2A24"
                                   Text="Trash" />
                        <ItemsControl x:Name="BackupTilesItemsControl"
                                      Margin="0,10,0,0"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,14,14" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="#FFFDF8"
                BorderBrush="#D8D0C3"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Height="48"
                            Background="#D8D0C3"
                            CornerRadius="12,12,0,0" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SelectedNoteTabButton"
                                Style="{StaticResource LeftPanelTabButtonStyle}"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                ToolTip="Selected Note"
                                Click="SelectedNoteTabButton_Click">
                            <Grid Width="24"
                                  Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      Data="M5,3 H14 L19,8 V21 H5 Z M14,3 V8 H19" />
                            </Grid>
                        </Button>
                        <Button x:Name="GlobalSettingsTabButton"
                                Style="{StaticResource RightPanelTabButtonStyle}"
                                Grid.Column="1"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                ToolTip="Global Note Settings"
                                Click="GlobalSettingsTabButton_Click">
                            <Grid Width="24"
                                  Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M4,6 H20 M4,12 H20 M4,18 H20" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         HorizontalAlignment="Left"
                                         Margin="12,3,0,0"
                                         VerticalAlignment="Top" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         HorizontalAlignment="Left"
                                         Margin="6,9,0,0"
                                         VerticalAlignment="Top" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         HorizontalAlignment="Left"
                                         Margin="15,15,0,0"
                                         VerticalAlignment="Top" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="SelectedNotePanel"
                          Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#2E2A24"
                                           Text="Selected Note" />
                                <TextBlock x:Name="SelectedMetaTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="#6B6255"
                                           Text="Select a note tile." />
                            </StackPanel>

                            <Button x:Name="FavoriteToggleButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FavoriteIconButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    ToolTip="Favorite note"
                            Click="FavoriteToggleButton_Click">
                                <Grid Width="14"
                                      Height="14">
                                    <Path x:Name="FavoriteToggleOutlineIcon"
                                          Stretch="Fill"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M8,0.9 L10,5.2 L14.8,5.7 L11.2,8.9 L12.2,13.6 L8,11.2 L3.8,13.6 L4.8,8.9 L1.2,5.7 L6,5.2 Z" />
                                    <Path x:Name="FavoriteToggleFilledIcon"
                                          Stretch="Fill"
                                          Fill="#E1B751"
                                          Stroke="#B08A38"
                                          StrokeThickness="1.1"
                                          StrokeLineJoin="Round"
                                          Data="M8,0.9 L10,5.2 L14.8,5.7 L11.2,8.9 L12.2,13.6 L8,11.2 L3.8,13.6 L4.8,8.9 L1.2,5.7 L6,5.2 Z"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,12">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#3F4347"
                                       Text="Background" />
                            <WrapPanel x:Name="SelectedBackgroundPresetPanel" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Margin="0,0,0,12">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#3F4347"
                                       Text="Name" />
                            <Grid>
                                <Border Background="#FAF7F0"
                                        BorderBrush="#D8D0C3"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9,7">
                                    <TextBlock x:Name="SelectedTitleTextBlock"
                                               Cursor="IBeam"
                                               Foreground="#2E2A24"
                                               Text="-"
                                               TextWrapping="Wrap"
                                               MouseLeftButtonDown="SelectedTitleTextBlock_MouseLeftButtonDown" />
                                </Border>
                                <TextBox x:Name="SelectedTitleEditor"
                                         Style="{StaticResource ManagerInlineEditorTextBoxStyle}"
                                         AcceptsReturn="False"
                                         VerticalScrollBarVisibility="Disabled"
                                         Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Margin="0,0,0,12">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#3F4347"
                                       Text="Content" />
                            <Grid>
                                <Border Background="#FAF7F0"
                                        BorderBrush="#D8D0C3"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9,7"
                                        MouseLeftButtonDown="SelectedPreviewScrollViewer_MouseLeftButtonDown">
                                    <ScrollViewer x:Name="SelectedPreviewScrollViewer"
                                                  Style="{StaticResource SelectedReadOnlyScrollViewerStyle}"
                                                  Cursor="IBeam"
                                                  MouseLeftButtonDown="SelectedPreviewScrollViewer_MouseLeftButtonDown">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar"
                                                   BasedOn="{StaticResource ContentVerticalScrollBarStyle}" />
                                        </ScrollViewer.Resources>
                                        <TextBlock x:Name="SelectedPreviewTextBlock"
                                                   Foreground="#2E2A24"
                                                   TextWrapping="Wrap"
                                                   MouseLeftButtonDown="SelectedPreviewScrollViewer_MouseLeftButtonDown" />
                                    </ScrollViewer>
                                </Border>
                                <Border x:Name="SelectedPreviewEditorBorder"
                                        Background="#FAF7F0"
                                        BorderBrush="#D8D0C3"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <TextBox x:Name="SelectedContentEditor"
                                             Style="{StaticResource ManagerInlineEditorTextBoxStyle}"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Margin="0,0,0,12">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#3F4347"
                                       Text="Modified" />
                            <TextBlock x:Name="SelectedModifiedTextBlock"
                                       Foreground="#6B6255"
                                       Text="-" />
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Margin="0,0,0,12">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#3F4347"
                                       Text="Created" />
                            <TextBlock x:Name="SelectedCreatedTextBlock"
                                       Foreground="#6B6255"
                                       Text="-" />
                        </StackPanel>

                        <StackPanel Grid.Row="6"
                                    Margin="0,16,0,0">
                            <Button x:Name="ToggleHiddenButton"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Margin="0,0,0,8"
                                    Content="Hide Note"
                                    Click="ToggleHiddenButton_Click" />
                            <Button x:Name="DeleteNoteButton"
                                    Style="{StaticResource DangerPanelButtonStyle}"
                                    Margin="0,0,0,8"
                                    Content="Delete Note"
                                    Click="DeleteNoteButton_Click" />
                            <Button x:Name="RestoreBackupButton"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed"
                                    Content="Restore"
                                    Click="RestoreBackupButton_Click" />
                            <Button x:Name="DeleteBackupPermanentlyButton"
                                    Style="{StaticResource DangerPanelButtonStyle}"
                                    Visibility="Collapsed"
                                    Content="Delete Permanently"
                                    Click="DeleteBackupPermanentlyButton_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="GlobalSettingsPanel"
                                  Margin="16,16,16,16"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource SidebarVerticalScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#2E2A24"
                                       Text="Global Settings" />

                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Title Font Size" />
                                <ComboBox x:Name="GlobalTitleFontSizeComboBox"
                                          Style="{StaticResource ManagerComboBoxStyle}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectionChanged="GlobalFontSetting_Changed" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Content Font Size" />
                                <ComboBox x:Name="GlobalContentFontSizeComboBox"
                                          Style="{StaticResource ManagerComboBoxStyle}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectionChanged="GlobalFontSetting_Changed" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Default Background" />
                                <ComboBox x:Name="GlobalDefaultBackgroundColorComboBox"
                                          Style="{StaticResource ManagerComboBoxStyle}"
                                          HorizontalContentAlignment="Left"
                                          SelectedValuePath="Value"
                                          SelectionChanged="GlobalFontSetting_Changed">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Left" />
                                            <Setter Property="Padding"
                                                    Value="8,4" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14"
                                                        Height="14"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding SwatchColor}"
                                                        BorderBrush="#CFC6B7"
                                                        BorderThickness="1"
                                                        CornerRadius="4" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding Label}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Corner Radius" />
                                <Slider x:Name="CornerRadiusSlider"
                                        Style="{StaticResource ManagerSliderStyle}"
                                        Minimum="0"
                                        Maximum="30"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="CornerRadiusSlider_ValueChanged" />
                                <TextBlock x:Name="CornerRadiusValueTextBlock"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Foreground="#2E2A24"
                                           Text="0" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Title Line Spacing" />
                                <ComboBox x:Name="GlobalTitleLineSpacingComboBox"
                                          Style="{StaticResource ManagerComboBoxStyle}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectionChanged="GlobalFontSetting_Changed" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Content Line Spacing" />
                                <ComboBox x:Name="GlobalContentLineSpacingComboBox"
                                          Style="{StaticResource ManagerComboBoxStyle}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectionChanged="GlobalFontSetting_Changed" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           FontWeight="SemiBold"
                                           Foreground="#3F4347"
                                           Text="Inactive Note Shade" />
                                <WrapPanel x:Name="HiddenNoteDarknessPresetPanel" />
                            </StackPanel>

                            <Button Margin="0,18,0,0"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Content="Open Notes Folder"
                                    Click="OpenNotesFolderButton_Click" />

                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Height="46"
                                    Click="GoogleDriveSettingsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16"
                                           Height="16"
                                           Margin="5,8,7,0"
                                           VerticalAlignment="Top"
                                           Source="pack://application:,,,/Assets/GoogleDriveIcon.png" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Backup Settings" />
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="9"
                                                   Foreground="#8E8578"
                                                   Text="Uses Google Drive for desktop" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

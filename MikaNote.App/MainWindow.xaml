                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#7A7063"
                                               Text="Sort by" />
                                    <Button x:Name="SortByModifiedButton"
                                            Style="{StaticResource SortModeButtonStyle}"
                                            ToolTip="Sort by last modified"
                                            Click="SortByModifiedButton_Click">

                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M3.6,1.5 V3.8 M8.4,1.5 V3.8 M2.3,4.7 H10.7" />
                                            </Grid>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="Created" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SortByTitleButton"
                                            Style="{StaticResource SortModeButtonStyle}"
                                            ToolTip="Sort alphabetically"
                                            Click="SortByTitleButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="12"
                                                  Height="12"
                                                  Margin="0,0,4,0">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.15"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M2.2,10 L4.9,2.4 L7.6,10 M3.4,7.5 H6.4" />
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.15"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M9.7,2.8 V10 M9.7,10 L8.1,8.4 M9.7,10 L11.3,8.4" />
                                            </Grid>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="A-Z" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#7A7063"
                                               Text="View" />
                                    <Button x:Name="FilterAllButton"
                                            Style="{StaticResource FilterModeButtonStyle}"
                                            ToolTip="Show all notes"
                                            Click="FilterAllButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="12"
                                                  Height="12">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"

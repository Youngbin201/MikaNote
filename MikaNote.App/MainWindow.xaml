                                    </Button>
                                    <Button x:Name="FilterHiddenButton"
                                            Style="{StaticResource FilterModeButtonStyle}"
                                            ToolTip="Show hidden notes"
                                            Click="FilterHiddenButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="12"
                                                  Height="12">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.1"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M1.5,6 C2.8,4.1 4.4,3.2 6,3.2 C7.6,3.2 9.2,4.1 10.5,6 C9.2,7.9 7.6,8.8 6,8.8 C4.4,8.8 2.8,7.9 1.5,6 Z" />
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M2.3,10.4 L9.9,1.8" />

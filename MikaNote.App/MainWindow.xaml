                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M2,4.7 L6,2.4 L10,4.7 L6,7 Z" />
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.05"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Opacity="0.72"
                                                      Data="M2,7.2 L6,9.5 L10,7.2 M2,9.3 L6,11.4 L10,9.3" />
                                            </Grid>
                                            <TextBlock Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="All" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FilterActiveButton"
                                            Style="{StaticResource FilterModeButtonStyle}"
